#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NUMBERS 1
#define SYMBOL_1 2
#define SYMBOL_2 3
#define ADMIN 4
#define AUTO_MOUSE 5
#define FACTORY 6

/ {
    chosen { zmk,physical-layout = &physical_layout_imprint_number_row; };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <50>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5       &kp N6        &kp N7         &kp N8       &kp N9       &kp N0        &kp MINUS
&kp TAB    &kp Q         &kp W         &kp E         &kp R         &kp T        &kp Y         &kp U          &kp I        &kp O        &kp P         &kp BSLH
&kp LCTRL  &hm LGUI A    &hm LALT S    &hm LCTRL D   &hm LSHFT F   &kp G        &kp H         &hm RSHFT J    &hm RCTRL K  &hm RALT L   &hm RGUI SEMI &kp SQT
&kp LSHFT  &kp Z         &kp X         &kp C         &kp V         &kp B        &kp N         &kp M          &kp COMMA    &kp DOT      &kp FSLH      &kp RSHFT
                      &kp LGUI      &kp LALT                                                           &kp LBKT      &kp RBKT
                                                  /* upper-left */  &kp RET  &kp DEL  &mo ADMIN
                                                  /* upper-right */ &kp GRAVE  &kp BSPC  &kp SPACE
                                                  /* lower-left */  &mt LC(LA(LSHFT)) TAB  &kp SPACE &lt NUMBERS ESC
                                                  /* lower-right */ &lt SYMBOL_1 ESC &lt NUMBERS RET &lt SYMBOL_2 BSPC
            >;
        };

        numbers_layer {
            bindings = <
&trans  &trans      &trans  &trans  &trans  &trans          &trans     &trans    &trans    &trans    &trans     &trans
&trans  &none       &none   &none   &none   &none           &kp MINUS  &kp N7    &kp N8    &kp N9    &kp EQUAL  &trans
&trans  &kp K_BACK  &none   &none   &none   &kp K_FORWARD   &kp BSLH   &kp N4    &kp N5    &kp N6    &kp N0     &trans
&trans  &none       &none   &none   &none   &none           &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp FSLH   &trans
                 &trans  &trans                                                            &trans    &trans
                                      &trans     &trans  &trans       &trans     &trans    &trans
                                      &trans     &trans  &trans       &trans     &trans    &trans
            >;
        };

        Symbol_1_Layer {
            bindings = <
&trans     &trans     &trans     &trans      &trans     &trans            &trans     &trans        &trans        &trans      &trans    &trans
&trans     &kp LBRC   &kp LPAR   &kp RPAR    &kp RBRC   &kp QMARK         &none      &none         &none         &none       &none     &trans
&trans     &kp CARET  &kp EQUAL  &kp UNDER   &kp DLLR   &kp STAR          &kp LEFT   &kp DOWN      &kp UP        &kp RIGHT   &none     &trans
&trans     &kp EXCL   &kp LBKT   &kp RBKT    &kp MINUS  &kp FSLH          &none      &none         &none         &none       &none     &trans
                 &trans     &trans                                                             &trans    &trans
                                      &trans     &trans  &trans       &trans     &trans    &trans
                                      &trans     &trans  &trans       &trans     &trans    &trans
            >;
        };

        Symbol_2_Layer {
            bindings = <
&trans     &trans      &trans      &trans     &trans     &trans          &trans      &trans      &trans      &trans      &trans      &trans
&trans     &kp HASH    &kp COLON   &kp SEMI   &kp SQT    &kp DQT         &none       &none       &none       &none       &none       &trans
&trans     &kp TILDE   &kp LT      &kp GT     &kp PIPE   &kp BSLH        &none       &none       &none       &none       &none       &trans
&trans     &kp AT      &kp AMPS    &kp PRCNT  &kp PLUS   &kp DOT         &none       &none       &none       &none       &none       &trans
                 &trans     &trans                                                             &trans      &trans
                                                   &trans        &trans        &trans             &trans           &trans           &trans
                                                   &trans        &trans        &trans             &trans           &trans           &trans
            >;
        };

        Admin_Layer {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &rgb_ug RGB_TOG &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI
&trans       &trans        &trans        &trans        &trans        &trans         &rgb_ug RGB_HUD &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &trans
&trans       &trans        &trans        &trans        &trans        &trans         &trans          &kp K_VOL_DN     &kp K_VOL_UP     &kp K_MUTE       &trans           &trans
&to FACTORY  &trans        &trans        &trans        &trans        &trans         &trans          &trans           &trans           &trans           &trans           &to FACTORY
                 &trans        &trans                                                             &trans           &trans
                                                   &trans        &trans        &trans             &trans           &trans           &trans
                                                   &trans        &trans        &trans             &trans           &trans           &trans
            >;
        };

        Auto_Mouse_Layer {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
                 &trans     &trans                                                      &trans  &trans
                                      &trans     &trans  &trans   &mkp LCLK  &mkp MCLK  &mkp RCLK
                                      &trans     &trans  &trans   &trans  &trans  &trans
            >;
        };

        factory_test {
            bindings = <
&kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7         &kp N8  &kp N9  &kp N0  &kp N1  &kp N2  &kp N3
&kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9         &kp N0  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5
&kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp N1         &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7
&kp N8  &kp N9  &kp N0  &kp N1  &kp N2  &kp N3         &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9
                 &kp N2  &kp N3                                                     &kp N7  &kp N8
                                      &kp N1  &kp N2  &kp N3   &kp N4  &kp N5  &kp N6
                                      &kp N7  &kp N8  &kp N9   &kp N0  &kp N1  &kp N2
            >;
        };
    };
};

// right hand trackball configuration

&trackball_peripheral_listener {
    input-processors =
        // activate the mouse button layer while the right trackball is moving
        <&zip_temp_layer AUTO_MOUSE 500>;
};

//left hand trackball configuration

&trackball_central_listener {
    input-processors =
        // multiply sensitivity by 1, divide by 8 (make it significantly slower for scrolling),
        <&zip_xy_scaler 1 8>,
        // make this trackball output scrolling events by default instead of cursor movement,
        <&zip_xy_to_scroll_mapper>,
        // invert vertical scrolling so that the view moves in the same direction as the top of the trackball.,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
